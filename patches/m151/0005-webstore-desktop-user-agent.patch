     }
 
+    /** Afterbird: whether {@code url} is a Chrome Web Store page. */
+    public static boolean isChromeWebStore(@Nullable GURL url) {
+        if (url == null || url.isEmpty()) {
+            return false;
+        }
+        String host = url.getHost();
+        if ("chromewebstore.google.com".equals(host)) {
+            return true;
+        }
+        return "chrome.google.com".equals(host) && url.getPath().startsWith("/webstore");
+    }
