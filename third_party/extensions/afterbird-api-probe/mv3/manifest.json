{
  "manifest_version": 3,
  "name": "Afterbird API Probe (MV3)",
  "version": "1.0.0",
  "description": "Probes which chrome.* extension APIs are available and working in the current browser build.",
  "default_locale": "en",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Afterbird API Probe (MV3)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "contextMenus",
    "declarativeNetRequest",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "probe-rerun": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Re-run Afterbird API probes"
    }
  }
}
